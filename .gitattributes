# Preserve extracted toolchains byte-for-byte, including original line endings.
/toolchains/vc6/** -text -filter
/toolchains/vc6rtm/** -text -filter
/toolchains/vc7/** -text -filter
/toolchains/d6rtm/** -text -filter
/toolchains/d6u1/** -text -filter
/toolchains/d6u2/** -text -filter

# Retain upstream zlib source bytes and the original embedded XML payload.
/src/nemu64/vendor/zlib-1.1.3/** -text -filter -whitespace
/src/nemu64/nemu64.manifest -text -filter -whitespace

# Retain the imported LemD3D source's encoding and historical whitespace.
/src/lemd3d/*.cpp -text -filter -whitespace
/src/lemd3d/*.h -text -filter -whitespace
/src/lemd3d/*.rc -text -filter -whitespace
/src/lemd3d/*.asm -text -filter -whitespace
/analysis/lemd3d-source-changes.patch -whitespace

# Preserve the minimal upstream Kaillera/JNetLib source and historical packer.
/src/kailleraclient/jnetlib/** -text -filter -whitespace
/src/kailleraclient/kailleraclient.h -text -filter -whitespace
/toolchains/upx120/** -text -filter
