    CONTROL "", IDC_CODE_VALUES, "ListBox", LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | WS_TABSTOP, 280, 30, 70, 130
    CONTROL "Delete", IDC_DELETE_VALUE, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 280, 180, 50, 14
    CONTROL "Add", IDC_ADD_VALUE, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 280, 165, 50, 14
    CONTROL "Code Names", IDC_STATIC, "Static", SS_LEFTNOWORDWRAP | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 120, 20, 42, 8
    CONTROL "Code values", IDC_STATIC, "Static", SS_LEFT | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 280, 20, 40, 8
    CONTROL "", IDC_ACTIVE_CODE_NAMES, "ListBox", LBS_NOTIFY | LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_HSCROLL | WS_VSCROLL | WS_TABSTOP, 15, 30, 70, 130
