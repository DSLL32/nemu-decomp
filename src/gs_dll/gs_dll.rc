    CONTROL "", IDC_CODE_NAMES, "ListBox", LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_HSCROLL | WS_VSCROLL | WS_TABSTOP, 120, 30, 150, 130
    CONTROL "Remove", IDC_REMOVE_CODE, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 180, 50, 15
    CONTROL "Properties", IDC_PROPERTIES, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 280, 195, 50, 15
