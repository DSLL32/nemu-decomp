// Resource IDs, styles, ordering, text and version fields retained from audio.dll.
#include <windows.h>
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

101 DIALOGEX 0, 0, 219, 353
STYLE 0x80c000c0
EXSTYLE 0x00000200
CAPTION "      Audio Configuration"
FONT 8, "MS Sans Serif", 0, 0, 0
BEGIN
    CONTROL "OK", 1, "Button", 0x50030001, 90, 295, 50, 14, 0x00000000
    CONTROL "Cancel", 2, "Button", 0x50030000, 90, 316, 50, 14, 0x00000000
    CONTROL "D&ummy mode", 1005, "Button", 0x50010003, 20, 40, 59, 10, 0x00000000
    CONTROL "HLE &Filter", 1019, "Button", 0x58000003, 20, 60, 55, 10, 0x00000000
    CONTROL "&Debug mode", 1006, "Button", 0x58010003, 15, 205, 57, 10, 0x00000000
    CONTROL "HLE &Log", 1014, "Button", 0x58000003, 15, 234, 50, 10, 0x00000000
    CONTROL "&HLE.WAV (games)", 1015, "Button", 0x50000003, 15, 249, 75, 10, 0x00000000
    CONTROL "&AI.WAV (demos)", 1016, "Button", 0x50000003, 15, 262, 68, 10, 0x00000000
    CONTROL "General Settings", 1017, "Button", 0x50000007, 5, 30, 105, 90, 0x00000000
    CONTROL "Debug Options", 1018, "Button", 0x50000007, 5, 190, 105, 90, 0x00000000
    CONTROL "Logging", 1020, "Static", 0x50020000, 15, 222, 26, 8, 0x00000000
    CONTROL "HL&E Audio", 1024, "Button", 0x50000003, 20, 50, 50, 10, 0x00000000
    CONTROL "&Reverse Stereo", 1025, "Button", 0x50000003, 20, 70, 65, 10, 0x00000000
    CONTROL "&Prebuffering", 1026, "Button", 0x50000003, 20, 80, 54, 10, 0x00000000
    CONTROL "High &Quality", 1029, "Button", 0x50000003, 20, 90, 54, 10, 0x00000000
    CONTROL "Using these options you can log sound ouput to a file on your harddrive.  It will not work if you load the rom from a CD. If boxes are grey that means that are not intended for your use.", -1, "Static", 0x50020000, 115, 195, 85, 60, 0x00000000
    CONTROL "Dummy mode turns off all sound but makes some games not work and makes other games work better. Prebuffering is recommended for most commercial games, but not demos. High Quality makes many games sound better.", -1, "Static", 0x50020000, 115, 35, 85, 90, 0x00000000
    CONTROL "&Sync Game to Audio", 1031, "Button", 0x50000003, 20, 100, 80, 10, 0x00000000
    CONTROL "Driver Info", 1033, "Button", 0x50010000, 165, 326, 50, 14, 0x00000000
    CONTROL "About", 1035, "Button", 0x50010000, 5, 326, 50, 14, 0x00000000
    CONTROL "Slider1", 1036, "msctls_trackbar32", 0x50010005, 25, 146, 144, 24, 0x00000001
    CONTROL "Prebuffer Size", -1, "Button", 0x50000007, 5, 124, 185, 60, 0x00000000
    CONTROL "More Accurate", -1, "Static", 0x50020000, 25, 171, 48, 8, 0x00000000
    CONTROL "Less Accurate", -1, "Static", 0x50020000, 123, 171, 46, 8, 0x00000000
    CONTROL "Faster CPU", -1, "Static", 0x50020000, 25, 137, 37, 8, 0x00000000
    CONTROL "Slower CPU", -1, "Static", 0x50020000, 130, 137, 39, 8, 0x00000000
    CONTROL "default", 1042, "Button", 0x50010000, 95, 5, 35, 15, 0x00020000
END

1 VERSIONINFO
 FILEVERSION 1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "LaC's AudioHLE DLL -- LE/BE/MMX Version"
            VALUE "CompanyName", " Nemu"
            VALUE "FileDescription", "audio"
            VALUE "FileVersion", "1, 0, 0, 1"
            VALUE "InternalName", "audio"
            VALUE "LegalCopyright", "Copyright © 2001"
            VALUE "OriginalFilename", "audio.dll"
            VALUE "ProductName", "  audio"
            VALUE "ProductVersion", "1, 0, 0, 1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
