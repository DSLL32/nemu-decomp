    CONTROL "Nemu64 - Version 0.8", IDC_STATIC, "Static", 0x50000000L, 24, 144, 71, 8
    CONTROL IDB_ABOUT, IDCANCEL, "Static", 0x5000100eL, 24, 12, 201, 124
    CONTROL "N64 Emulator made by Lemmy and LaC", IDC_STATIC, "Static", 0x50000000L, 24, 156, 125, 8
    CONTROL "Credits go to: hWnd, Zilmar, Atila, Demo, schibo, Duddie, myzar, F|res, rcp, EmuManiac, Coolbest, Zoric and everyone I forgot to mention", IDC_STATIC, "Static", 0x50000000L, 24, 168, 200, 24
    CONTROL "&Disclaimer", IDC_DISCLAIMER, "Button", 0x50010000L, 180, 220, 60, 16
    CONTROL "Other N64 Emulators", IDC_STATIC, "Button", 0x50000007L, 24, 196, 152, 60
    CONTROL "1964: www.emuhq.com/1964", IDC_STATIC, "Static", 0x50000000L, 28, 208, 95, 8
    CONTROL "TrueReality: www.emuhq.com/truereality", IDC_STATIC, "Static", 0x50020000L, 28, 218, 129, 8
    CONTROL "Corn: www.emuhq.com/corn", IDC_STATIC, "Static", 0x50020000L, 28, 228, 92, 8
    CONTROL "UltraHLE: www.ultrahle.com", IDC_STATIC, "Static", 0x50020000L, 28, 238, 90, 8
    CONTROL "Official page: www.nemu.com", IDC_STATIC, "Static", 0x50020000L, 128, 140, 95, 8
    CONTROL "www.nemu.com", IDC_WEBSITE, "Button", 0x50010000L, 180, 240, 60, 16
END

