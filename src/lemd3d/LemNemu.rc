IDD_SETTINGS DIALOGEX 0, 0, 203, 207
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Lemmy's video debugger"
FONT 8, "MS Sans Serif", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,145,186,50,14
    LTEXT           "Showing no texture",IDC_STATICTEXTUREINDEX,10,15,100,8
    PUSHBUTTON      "Next",IDC_BUTTONTEXTURENEXT,10,60,50,15
    PUSHBUTTON      "Previous",IDC_BUTTONTEXTUREPREVIOUS,65,60,50,15
    GROUPBOX        "Texture debugger",IDC_STATIC,4,7,191,74
    CONTROL         "Show Alpha",IDC_BACKGROUND,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,120,60,60,10
    LTEXT           "Texture Details",IDC_STATICTEXTUREDETAILS,10,25,180,35
    PUSHBUTTON      "Profile times...",IDC_BUTTONSHOWPROFILER,4,185,50,15
    CONTROL         "Log Commands",IDC_COMMANDLOG,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,4,84,65,10
    CONTROL         "Export VRML",IDC_CHECKVRML,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,4,96,58,9
    CONTROL         "Show culling stats",IDC_CHECKCULLSTATS,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,4,120,74,10
    CONTROL         "Emulate cull commands",IDC_CHECKDOCULLING,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,4,108,96,9
    CONTROL         "Disable texture cache",IDC_CHECKDISABLETEXTURECACHE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,4,132,87,8
    GROUPBOX        "Stats",IDC_STATIC,110,90,85,70
    LISTBOX         IDC_LIST,115,100,75,35,LBS_SORT | LBS_NOSEL | WS_TABSTOP
    PUSHBUTTON      "Reset",IDC_BUTTONRESET,115,140,75,14
    CONTROL         "CIMG Tracing",IDC_CHECKCIMGTRACING,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,4,144,60,8
    CONTROL         "Force Z Clear",IDC_CHKFORCEZCLEAR,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,4,156,88,8
    CONTROL         "Force Z Buffer",IDC_CHKFORCEZBUFFER,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,4,169,88,8
END

IDD_PROFILETIMES DIALOG  0, 0, 184, 125
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
