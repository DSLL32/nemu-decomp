  "source_distinction": "The scalar sibling was solved with a separate destination=context->buffer local at sample-loop entry. This justified testing the previously absent bare-base local at natural Pole boundaries, without changing arithmetic or introducing register bindings.",
  "new_forms": {
    "gain-per-tap": "Initialize samples=context->buffer inside every direct-gain tap iteration, then load samples[input+tap]. All other buffer expressions remain unchanged.",
    "entry-all": "Initialize a short* PCM base at function entry and use it for all subsequent PCM accesses, including coefficient base.",
    "before-history-all": "Declare the base among locals, load after the count guard and before restoring/resetting history; use it for all subsequent PCM accesses.",
    "after-history-all": "Load the base just after history restore/reset, before deriving the coefficient pointer; use it thereafter.",
    "outer-all": "Initialize the base at the start of each eight-sample block and use it for input, output and output-history accesses.",
    "gain-all": "Initialize the base in a scope beginning before the direct gain pass; use it for input, output and output-history accesses.",
    "outer-output": "Initialize at eight-sample block entry; use only for output stores and the two subsequent output-history reads.",
    "gain-output": "Initialize before direct gain pass; use only for output stores and output-history reads.",
    "outer-store": "Initialize at block entry; use only for the destination store, matching the scalar sibling more closely.",
    "gain-store": "Initialize before direct gain pass; use only for the destination store."
  },
